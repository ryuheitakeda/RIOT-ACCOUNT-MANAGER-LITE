<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/RiotAccountsLite.ico</ApplicationIcon>
    <AssemblyName>RiotAccountsLite</AssemblyName><Version>1.0.0</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/RiotAccountsLite.ico" />
    <ProjectReference Include="../RiotAccountsLite.Core/RiotAccountsLite.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>
